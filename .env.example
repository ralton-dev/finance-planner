# Copy to .env for local development (docker-compose reads these).
POSTGRES_USER=finance
POSTGRES_PASSWORD=finance
POSTGRES_DB=finance
DATABASE_URL=postgres://finance:finance@localhost:5432/finance
REDIS_URL=redis://localhost:6379

# Shared HS256 secret for signing/verifying access tokens (set the same value
# for the api and auth services). Use a strong random value in real environments.
JWT_SIGNING_KEY=dev-insecure-secret-change-me

# Service ports
API_PORT=4000
AUTH_PORT=4001
CALC_PORT=4002
WEB_PORT=5173

# Public origin of the SPA. Used for emailed links (password reset) and as the
# landing spot after a successful single sign-on round-trip.
PUBLIC_WEB_URL=http://localhost:5173

# Outbound mail, read by both the auth service (verification + password reset)
# and the api service (the daily digest). Without SMTP_URL messages are logged
# instead of sent — fine for local dev, where the reset link appears in the log.
# SMTP_URL=smtps://user:password@smtp.example.com:465
# MAIL_FROM=Finance Planner <no-reply@example.com>

# Daily email digest ("due in the next 7 days" + "transfers for the next 7
# days"), sent by the api service to users who opted in via PATCH /auth/me.
# The sender runs in-process on a 15-minute tick and only works once the local
# hour has reached NOTIFY_HOUR. It assumes a single api replica — if you ever
# run more, enable it on one of them (a unique (user, day, kind) key in
# core.notification_log makes a double-send harmless either way).
NOTIFY_ENABLED=false
NOTIFY_HOUR=8

# Expose POST /api/demo/seed, which plants a worked multi-account example into
# an otherwise-empty profile so a first-run install has something to look at.
# The route 404s while this is false; GET /api/meta reports whether it is on.
ENABLE_DEMO_SEED=false

# OIDC single sign-on. All four must be set or SSO stays off
# (GET /auth/oidc/meta reports {"enabled": false}). The redirect URI must be
# registered with the provider and must point at the *gateway* callback path —
# the handshake cookies are scoped to COOKIE_PATH (/api/auth), so a callback
# delivered straight to the auth service port would arrive without them.
# OIDC_ISSUER=https://idp.example.com
# OIDC_CLIENT_ID=finance-planner
# OIDC_CLIENT_SECRET=change-me
# OIDC_REDIRECT_URI=http://localhost:4000/api/auth/oidc/callback

LOG_LEVEL=info
