# Copy to .env for local development (docker-compose reads these).
POSTGRES_USER=finance
POSTGRES_PASSWORD=finance
POSTGRES_DB=finance
DATABASE_URL=postgres://finance:finance@localhost:5432/finance
REDIS_URL=redis://localhost:6379

# Shared HS256 secret for signing/verifying access tokens (set the same value
# for the api and auth services). Use a strong random value in real environments.
JWT_SIGNING_KEY=dev-insecure-secret-change-me

# Service ports
API_PORT=4000
AUTH_PORT=4001
CALC_PORT=4002
WEB_PORT=5173

LOG_LEVEL=info
