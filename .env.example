# Copy to .env for local development (docker-compose reads these).
POSTGRES_USER=finance
POSTGRES_PASSWORD=finance
POSTGRES_DB=finance
DATABASE_URL=postgres://finance:finance@localhost:5432/finance
REDIS_URL=redis://localhost:6379

# Shared HS256 secret for signing/verifying access tokens (set the same value
# for the api and auth services). Use a strong random value in real environments.
JWT_SIGNING_KEY=dev-insecure-secret-change-me

# Service ports
API_PORT=4000
AUTH_PORT=4001
CALC_PORT=4002
WEB_PORT=5173

# Public origin of the SPA. Used for emailed links (password reset) and as the
# landing spot after a successful single sign-on round-trip.
PUBLIC_WEB_URL=http://localhost:5173

# Outbound mail, read by both the auth service (verification + password reset)
# and the api service (the daily digest). Without SMTP_URL messages are logged
# instead of sent — fine for local dev, where the reset link appears in the log.
# SMTP_URL=smtps://user:password@smtp.example.com:465
# MAIL_FROM=Finance Planner <no-reply@example.com>

# Daily email digest ("due in the next 7 days" + "transfers for the next 7
# days"), sent by the api service to users who opted in via PATCH /auth/me.
# The sender runs in-process on a 15-minute tick and only works once the local
# hour has reached NOTIFY_HOUR. It assumes a single api replica — if you ever
# run more, enable it on one of them (a unique (user, day, kind) key in
# core.notification_log makes a double-send harmless either way).
NOTIFY_ENABLED=false
NOTIFY_HOUR=8

# Expose POST /api/demo/seed, which plants a worked multi-account example into
# an otherwise-empty profile so a first-run install has something to look at.
# The route 404s while this is false; GET /api/meta reports whether it is on.
ENABLE_DEMO_SEED=false

# Expose GET /api/debug/plan, the engine's calculation trace, and its page in
# the app. The route 404s while this is false; GET /api/meta reports whether it
# is on, and the link stays out of settings when it is not.
#
# Turn it on knowing what it prints. The engine plans over a whole *scope* —
# every account in a funding relationship with the one being explained — so a
# household member reading the trace sees the household's full calculation,
# co-members' personal accounts included, with their incomes, bills and
# balances. That is the trace being useful rather than a leak in it, but it
# means the decision belongs to whoever runs the deployment, not to each user.
ENABLE_PLAN_DEBUG=false

# OIDC single sign-on. All four must be set or SSO stays off
# (GET /auth/oidc/meta reports {"enabled": false}). The redirect URI must be
# registered with the provider and must point at the *gateway* callback path —
# the handshake cookies are scoped to COOKIE_PATH (/api/auth), so a callback
# delivered straight to the auth service port would arrive without them.
# OIDC_ISSUER=https://idp.example.com
# OIDC_CLIENT_ID=finance-planner
# OIDC_CLIENT_SECRET=change-me
# OIDC_REDIRECT_URI=http://localhost:4000/api/auth/oidc/callback

LOG_LEVEL=info

# Distributed tracing. A request that crosses a process boundary is still one
# request, and without this each service logs its own private request counter
# and nothing joins the two lines. With it on, the api → auth hop carries a
# `traceparent`, both services report spans under one trace id, and every Pino
# line picks up a matching `trace_id`.
#
# Off is genuinely off: the services are started with a `--import` preload whose
# whole body sits behind this flag, so with it false they load no OpenTelemetry
# module at all. Turning it on is worth about a millisecond of startup.
#
# `make up-otel` sets this to true for you and starts a collector that prints
# every span it receives (`make logs-otel`). Setting it here instead turns
# tracing on for a plain `make up`, which needs a collector you have started
# yourself — the services do not wait for one and do not fail without one.
OTEL_ENABLED=false

# Where to send spans. Required whenever OTEL_ENABLED=true: the OTLP spec
# defaults this to http://localhost:4318, so an unset endpoint would not look
# unset to the SDK — it would export into the void — and the services refuse to
# start rather than do that. Leave it commented and compose supplies the
# collector's in-network address.
#
# Give it a *bare origin*. The SDK appends /v1/traces to this variable. Its
# per-signal sibling OTEL_EXPORTER_OTLP_TRACES_ENDPOINT is used verbatim, so the
# same value there would POST to / and drop every span without saying so.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318

# The escape hatch, and the reason it is listed. A collector that refuses the
# connection is completely silent at the default log level: the service starts,
# serves 200s, produces spans and never says that none of them arrived. So the
# symptom of a wrong endpoint and the symptom of a working one are the same
# thing on stdout. Set this to debug and the exporter's failures are printed.
# OTEL_LOG_LEVEL=debug

# Reported by /healthz as `version`. Unset, the services report "0.0.0", which
# is also what all three package.json files say, so it has never been a real
# version of anything. In a cluster the chart sets this from the image tag; a
# locally-built compose image has no tag, so compose sets it to "dev".
# APP_VERSION=1.2.3
